# PostgreSQL 連線（本機 / Vercel 用 Neon）
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bookmark"

# Session 簽章密碼（部署時務必改成隨機長字串）
NUXT_SESSION_PASSWORD="change-me-to-a-long-random-string"

# 第一個使用者（seed 用）
SEED_EMAIL="admin@example.com"
SEED_PASSWORD="change-me"

# SMTP 發信（未設定時 → 測試模式，密碼寫入 系統暫存目錄）
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Google OAuth 登入（選用）— 在 Google Cloud Console 建立 OAuth 2.0 Client ID
# 教學：https://console.cloud.google.com/apis/credentials
# 授權重新導向 URI：http://localhost:3000/api/auth/google/callback（本機）與 https://<你的網域>/api/auth/google/callback（正式）
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
